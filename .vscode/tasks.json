{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lint",
            "type": "shell",
            "command": "run-clang-tidy -p build",
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "close": false
            }
        },
        {
            "label": "Format",
            "type": "shell",
            "linux": {
                "command": "find . -type f -not -path './build/*' \\( -name '*.cpp' -o -name '*.h' \\) -exec clang-format -i {} +"
            },
            "windows": {
                "command": "Get-ChildItem -Recurse -File -Include *.cpp,*.h | Where-Object { $_.FullName -notlike '*\\build\\*' } | ForEach-Object { clang-format -i $_.FullName }"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "close": false
            }
        }
    ]
}
